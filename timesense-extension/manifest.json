{
  "manifest_version": 3,
  "name": "TimeSense",
  "version": "1.0.0",
  "description": "Track your browsing behavior and sync with TimeSense for personalized productivity insights.",
  "permissions": [
    "history",
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://time-sense.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}